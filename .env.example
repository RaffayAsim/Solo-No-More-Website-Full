# ─────────────────────────────────────────────────────────────────────────────
# Solo-No-More environment variables
# Copy to .env.local for local development and set the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only needed if some users still hold sessions signed with the legacy
# HS256 secret; without it those tokens are checked against Supabase directly.
SUPABASE_JWT_SECRET=

# Platform owner / root admins — comma separated emails. These accounts always have
# full admin access and can never be registered through public sign-up.
# (Accounts whose profile has subscription_tier = 'admin' are admins as well.)
ADMIN_EMAILS=owner@example.com

# Bank transfer details shown to customers on every payment screen.
# Until these are set, a clearly-marked SAMPLE account is displayed.
NEXT_PUBLIC_PAYMENT_BANK_NAME=
# Optional. Shown under the bank name when set.
NEXT_PUBLIC_PAYMENT_BRANCH=
NEXT_PUBLIC_PAYMENT_ACCOUNT_TITLE=
# Optional. The "Account Number" row is hidden when this is empty.
NEXT_PUBLIC_PAYMENT_ACCOUNT_NUMBER=
NEXT_PUBLIC_PAYMENT_IBAN=
NEXT_PUBLIC_PAYMENT_RAAST_ID=
# WhatsApp number customers send their payment proof to. Digits only, with country
# code and no leading zero or plus sign (e.g. 923001234567).
NEXT_PUBLIC_PAYMENT_WHATSAPP=

# Public address of the site, used for links inside emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Outgoing email (SMTP). For Gmail: SMTP_USER is the Gmail address and SMTP_PASS is a
# 16-character App Password (Google Account → Security → 2-Step Verification → App
# passwords) — NOT the normal Gmail password. Emails are skipped until both are set.
SMTP_USER=
SMTP_PASS=
# Optional overrides (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM_NAME=Solo-No-More
# EMAIL_REPLY_TO=
# Where "new application" / "new payment proof" / contact-form alerts are sent.
# Comma-separated list allowed, e.g. a@example.com,b@example.com (leave empty to disable)
ADMIN_NOTIFY_EMAIL=

# Secret for the daily membership-expiry job (any long random string).
CRON_SECRET=
